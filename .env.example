# Environment Variables Template
# Copy this file to .env and fill in your actual values
# ⚠️ NEVER commit .env to Git!

# Session Encryption
SESSION_SECRET=your-random-secret-key-min-32-chars-here
SESSION_SALT=your-random-salt-here

# API Configuration
API_ENDPOINT=https://kingcongstudio.com
LOGIN_URL=https://kingcongstudio.com/serverkingcong_tools/login.php

# Application Settings
NODE_ENV=production
ENABLE_DEVTOOLS=false

# Optional: API Keys (if needed in future)
# ELEVENLABS_API_KEY=your_key_here
# MINIMAX_API_KEY=your_key_here

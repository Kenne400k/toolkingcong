{
  "name": "kingcong-tts-tool",
  "version": "1.10.48",
  "description": "Text-to-Speech Desktop Tool for KingCong Studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:secure": "node scripts/build-secure.js"
  },
  "keywords": [
    "electron",
    "tts",
    "text-to-speech",
    "kingcong"
  ],
  "author": "@Kenne400k",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "javascript-obfuscator": "^5.1.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "form-data": "^4.0.0",
    "node-fetch": "^2.7.0"
  },
  "build": {
    "appId": "com.kingcong.ttstool",
    "productName": "KingCong TTS Tool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "image/**/*",
      "!sessions",
      "!*.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "image/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KingCong Tool",
      "deleteAppDataOnUninstall": true
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ]
  }
}

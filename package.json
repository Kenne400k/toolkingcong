{
  "name": "kingcong-tts-tool",
  "version": "1.5.0",
  "description": "Text-to-Speech Desktop Tool for KingCong Studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "keywords": [
    "electron",
    "tts",
    "text-to-speech",
    "kingcong"
  ],
  "author": "KingCong Studio",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "node-fetch": "^2.7.0",
    "form-data": "^4.0.0"
  },
  "build": {
    "appId": "com.kingcong.ttstool",
    "productName": "KingCong TTS Tool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "image/**/*",
      "!sessions",
      "!*.md"
    ],
    "win": {
      "target": "nsis",
      "icon": "image/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "image/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "image/icon.png"
    }
  }
}

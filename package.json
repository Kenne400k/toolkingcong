{
  "name": "kingcong-tts-tool",
  "version": "1.11.1",
  "description": "Text-to-Speech Desktop Tool for KingCong Studio",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:secure": "node scripts/build-secure.js",
    "release": "node scripts/build-and-release.js"
  },
  "keywords": [
    "electron",
    "tts",
    "text-to-speech",
    "kingcong"
  ],
  "author": "@Kenne400k",
  "license": "MIT",
  "devDependencies": {
    "archiver": "^7.0.1",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.0",
    "javascript-obfuscator": "^5.1.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "dotenv": "^16.3.1",
    "form-data": "^4.0.0",
    "node-fetch": "^2.7.0"
  },
  "build": {
    "appId": "com.kingcong.ttstool",
    "productName": "KingCong TTS Tool",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "version.json",
      "renderer/**/*",
      "image/**/*",
      "!sessions",
      "!*.md"
    ],
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["x64", "arm64"] }
      ],
      "icon": "image/icon.png",
      "category": "public.app-category.utilities"
    },
    "dmg": {
      "title": "KingCong TTS Tool",
      "window": { "width": 540, "height": 380 }
    },
    "win": {
      "target": "nsis",
      "icon": "image/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KingCong Tool",
      "deleteAppDataOnUninstall": true
    },
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ]
  }
}